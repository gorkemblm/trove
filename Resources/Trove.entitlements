<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox on. No network entitlement: the app cannot connect anywhere. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The user picks the storage folder in an open panel. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Keeps access to that folder after a restart. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Sparkle's installer and download services (XPC). Trove talks to them; only the download
	     service has network access. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>com.iokoda.clipboard-spks</string>
		<string>com.iokoda.clipboard-spki</string>
	</array>
	<!-- Reads (never writes) where macOS saves screenshots, to suggest that folder. -->
	<key>com.apple.security.temporary-exception.shared-preference.read-only</key>
	<array>
		<string>com.apple.screencapture</string>
	</array>
</dict>
</plist>
